---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href === path ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Software developer specialising in fast, thoughtful products. Available for freelance and full-time opportunities." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a href="/" class="name">Karol</a>
      <nav>
        <a href="/" aria-current={current('/')}>Home</a>
        <a href="/projects" aria-current={current('/projects')}>Projects</a>
        <a href="/signal" aria-current={current('/signal')}>Signal</a>
        <a href="https://github.com/ko-karol">GitHub</a>
        <a href="https://www.linkedin.com/in/ko-karol/">LinkedIn</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>ko-karol</p>
    </footer>
  </body>
</html>
