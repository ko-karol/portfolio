---
import '../styles/index.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Software developer specialising in fast, thoughtful products. Available for freelance and full-time opportunities." />
  <meta name="author" content="Karol" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Lora:ital@0;1&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- ─── SKIP LINK ────────────────────────────────────────── -->
  <a href="#main" class="skip-link">Skip to content</a>

  <!-- ─── NAV ─────────────────────────────────────────────── -->
  <Navigation />

  <slot />

  <!-- ─── FOOTER ────────────────────────────────────────────── -->
  <Footer />

  <script src="../scripts/main.js"></script>
</body>
</html>
