---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Software developer specialising in fast, thoughtful products. Available for freelance and full-time opportunities." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/" class="name">Karol</a>
      <nav>
        <a href="/">Home</a>
        <a href="/projects">Projects</a>
        <a href="/signal">Signal</a>
        <a href="https://github.com/ko-karol">GitHub</a>
        <a href="https://www.linkedin.com/in/ko-karol/">LinkedIn</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>ko-karol</p>
    </footer>
  </body>
</html>
