---
interface Props {
  project: string;
  label: string;
  title: string;
  description: string;
  tags: string[];
  link?: string;
  linkText?: string;
  tapeColor?: 'red' | 'yellow' | 'green' | 'blue' | 'purple';
}

const {
  project,
  label,
  title,
  description,
  tags,
  link,
  linkText = 'Visit ↗',
  tapeColor = 'red'
} = Astro.props;
---

<article
  class="project-card"
  data-project={project}
  role="button"
  tabindex="0"
  aria-label={`Open ${title} project detail`}
>
  <div class:list={['card-tape', `card-tape--${tapeColor}`]}></div>
  <div class="card-fold"></div>
  <header class="card-header">
    <span class="card-label">{label}</span>
    <div class="card-dots" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </header>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  <footer class="card-footer">
    <div class="card-tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
    {link ? (
      <a href={link} target="_blank" rel="noopener" class="card-cta" onclick="event.stopPropagation();">
        {linkText}
      </a>
    ) : (
      <span class="card-cta" aria-hidden="true">Details ↗</span>
    )}
  </footer>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--paper-white);
    border: 2.5px solid var(--ink-900);
    border-radius: var(--radius);
    padding: 1.75rem 1.5rem 1.5rem;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    cursor: pointer;
    transition:
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .project-card:hover {
    box-shadow: 10px 14px 0 rgba(22, 18, 14, 0.22), 18px 30px 0 rgba(22, 18, 14, 0.09);
    transform: translate(-2px, -2px);
  }

  .project-card:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  .card-fold {
    position: absolute;
    top: 0;
    right: 0;
    width: 28px;
    height: 28px;
    background: linear-gradient(225deg, var(--paper-tan) 50%, transparent 50%);
    border-left: 1.5px solid var(--paper-warm);
    border-bottom: 1.5px solid var(--paper-warm);
    z-index: 2;
  }

  .card-tape {
    position: absolute;
    top: -6px;
    left: 50%;
    translate: -50% 0;
    width: 48px;
    height: 14px;
    border-radius: 1px;
    opacity: 0.75;
    z-index: 3;
  }

  .card-tape--red    { background: #f09090; }
  .card-tape--yellow { background: #f5d87a; }
  .card-tape--green  { background: #8acc8a; }
  .card-tape--blue   { background: #7aaad8; }
  .card-tape--purple { background: #b8a8d8; }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-300);
    border: 1.5px solid var(--ink-100);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius);
    background: var(--paper-cream);
  }

  .card-dots {
    display: flex;
    gap: 0.3rem;
  }

  .card-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--paper-tan);
  }

  .card-dots span:nth-child(1) { background: #f5a0a0; }
  .card-dots span:nth-child(2) { background: var(--yellow); }
  .card-dots span:nth-child(3) { background: #8acc8a; }

  .card-title {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
    font-weight: 700;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--ink-500);
    line-height: 1.6;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: auto;
  }

  .card-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.68rem;
    font-weight: 600;
    background: var(--paper-cream);
    border: 1.5px solid var(--paper-tan);
    border-radius: var(--radius);
    padding: 0.12rem 0.45rem;
    color: var(--ink-500);
  }

  .card-cta {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-900);
    white-space: nowrap;
    border-bottom: 2px solid var(--ink-900);
    padding-bottom: 1px;
    transition: color var(--dur-fast), border-color var(--dur-fast);
    flex-shrink: 0;
  }

  .project-card:hover .card-cta {
    color: var(--red);
    border-color: var(--red);
  }
</style>
