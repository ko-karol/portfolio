---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <!-- Blueprint grid background -->
  <div class="blueprint-grid" aria-hidden="true"></div>
  
  <div class="container footer-inner">
    <!-- Red rubber stamp -->
    <div class="rubber-stamp">
      <div class="stamp-inner">
        <span class="stamp-name">KO-KAROL</span>
        <span class="stamp-year">{currentYear}</span>
      </div>
    </div>
    
    <!-- Contact links -->
    <div class="footer-links">
      <a href="mailto:karol@ko-karol.com" class="footer-link">karol@ko-karol.com</a>
      <span class="link-separator">/</span>
      <a href="https://github.com/ko-karol" target="_blank" rel="noopener" class="footer-link">GitHub</a>
      <span class="link-separator">/</span>
      <a href="https://www.linkedin.com/in/ko-karol/" target="_blank" rel="noopener" class="footer-link">LinkedIn</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #1a3a5c;
    color: #a8c5e2;
    padding: 4rem 0 3rem;
    position: relative;
    overflow: hidden;
  }

  /* Blueprint grid */
  .blueprint-grid {
    position: absolute;
    inset: 0;
    background-color: #1a3a5c;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .footer-inner {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    flex-wrap: wrap;
  }

  /* Rubber stamp */
  .rubber-stamp {
    transform: rotate(-4deg);
  }

  .stamp-inner {
    border: 3px solid #f5f0e0;
    border-radius: 3px;
    padding: 0.75rem 1.5rem;
    background: rgba(245, 240, 224, 0.1);
    box-shadow: 0 0 20px rgba(245, 240, 224, 0.1);
  }

  .stamp-name {
    display: block;
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: #f5f0e0;
    text-align: center;
    letter-spacing: 0.15em;
  }

  .stamp-year {
    display: block;
    font-family: 'Courier New', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    color: #f5f0e0;
    text-align: center;
    letter-spacing: 0.1em;
    margin-top: 0.25rem;
    opacity: 0.7;
  }

  /* Links */
  .footer-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: #a8c5e2;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .footer-link:hover {
    color: #fff;
    border-bottom-color: #c41e3a;
  }

  .link-separator {
    color: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 2rem;
    }
    .footer-links {
      flex-direction: column;
      gap: 0.75rem;
    }
    .link-separator {
      display: none;
    }
  }
</style>
