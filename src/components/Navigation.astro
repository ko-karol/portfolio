---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="site-header" role="banner">
  <nav class="nav" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label="Home">
      <span class="nav-logo-mark">K</span>
      <span class="nav-logo-dot"></span>
    </a>
    <ul class="nav-links" role="list">
      <li><a href="/#work" class="nav-link" class:list={{ active: currentPath === '/#work' }}>Work</a></li>
      <li><a href="/#process" class="nav-link" class:list={{ active: currentPath === '/#process' }}>Process</a></li>
      <li><a href="/#about" class="nav-link" class:list={{ active: currentPath === '/#about' }}>About</a></li>
      <li><a href="/signal" class="nav-link" class:list={{ active: currentPath === '/signal' }}>Signal</a></li>
      <li><a href="/#contact" class="nav-link btn-nav">Let's talk</a></li>
    </ul>
    <button class="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul role="list">
      <li><a href="/#work" class="mobile-link">Work</a></li>
      <li><a href="/#process" class="mobile-link">Process</a></li>
      <li><a href="/#about" class="mobile-link">About</a></li>
      <li><a href="/signal" class="mobile-link">Signal</a></li>
      <li><a href="/#contact" class="mobile-link">Let's talk</a></li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    pointer-events: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    max-width: 1100px;
    margin: 1.25rem auto 0;
    padding: 0.6rem 1.25rem 0.6rem 1rem;
    background: var(--paper-white);
    border: 2.5px solid var(--ink-900);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    pointer-events: auto;
    transform: rotate(-0.2deg);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 700;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .nav-logo-mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    background: var(--red);
    color: #fff;
    border-radius: var(--radius);
    border: 2px solid var(--ink-900);
    font-size: 0.95rem;
  }

  .nav-logo-dot {
    width: 6px;
    height: 6px;
    background: var(--ink-900);
    border-radius: 50%;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-500);
    padding-bottom: 2px;
    position: relative;
    transition: color var(--dur-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--red);
    transition: width var(--dur) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--ink-900);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .btn-nav {
    padding: 0.35rem 0.9rem;
    background: var(--ink-900);
    color: var(--paper-white);
    border-radius: var(--radius);
    border: 2px solid var(--ink-900);
    font-size: 0.85rem;
    font-weight: 700;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      transform var(--dur) var(--ease-spring),
      box-shadow var(--dur) var(--ease-out);
    box-shadow: 3px 3px 0 var(--ink-700);
  }

  .btn-nav:hover {
    background: var(--red);
    border-color: var(--red);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--ink-900);
  }

  .btn-nav::after {
    display: none;
  }

  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 0.3rem;
    margin-left: auto;
  }

  .nav-burger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--ink-900);
    border-radius: 1px;
    transition: transform var(--dur) var(--ease-out), opacity var(--dur-fast);
  }

  .mobile-menu {
    background: var(--paper-white);
    border: 2.5px solid var(--ink-900);
    border-top: none;
    padding: var(--space-md) var(--space-lg);
    max-width: 1100px;
    margin: 0 auto;
    pointer-events: auto;
  }

  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .mobile-link {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink-700);
    display: block;
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }

    .nav-burger {
      display: flex;
    }
  }
</style>
