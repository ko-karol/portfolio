---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost';
  size?: 'default' | 'large';
  block?: boolean;
  external?: boolean;
}

const { 
  href, 
  variant = 'primary', 
  size = 'default',
  block = false,
  external = false 
} = Astro.props;

const externalProps = external ? { target: '_blank', rel: 'noopener' } : {};
---

{
  href ? (
    <a 
      href={href} 
      class:list={['btn', `btn-${variant}`, size === 'large' && 'btn-large', block && 'btn-block']}
      {...externalProps}
    >
      <slot />
    </a>
  ) : (
    <button 
      type="button"
      class:list={['btn', `btn-${variant}`, size === 'large' && 'btn-large', block && 'btn-block']}
    >
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.6rem;
    font-size: 0.9rem;
    font-weight: 700;
    font-family: var(--font-sans);
    letter-spacing: 0.01em;
    border-radius: var(--radius);
    border: 2.5px solid var(--ink-900);
    transition:
      transform var(--dur) var(--ease-spring),
      box-shadow var(--dur) var(--ease-out),
      background var(--dur-fast),
      color var(--dur-fast);
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--red);
    color: #fff;
    box-shadow: 4px 4px 0 var(--ink-900);
  }

  .btn-primary:hover  { 
    transform: translate(-2px,-2px); 
    box-shadow: 6px 6px 0 var(--ink-900); 
  }
  
  .btn-primary:active { 
    transform: translate(2px,2px); 
    box-shadow: 2px 2px 0 var(--ink-900); 
  }

  .btn-ghost {
    background: transparent;
    color: var(--ink-900);
    box-shadow: 4px 4px 0 var(--ink-900);
  }

  .btn-ghost:hover  { 
    background: var(--ink-900); 
    color: var(--paper-white); 
    transform: translate(-2px,-2px); 
    box-shadow: 6px 6px 0 var(--ink-900); 
  }
  
  .btn-ghost:active { 
    transform: translate(2px,2px); 
    box-shadow: 2px 2px 0 var(--ink-900); 
  }

  .btn-large { 
    padding: 0.95rem 2.2rem; 
    font-size: 1rem; 
  }
  
  .btn-block { 
    width: 100%; 
  }
</style>
