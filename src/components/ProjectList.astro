---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  kind?: 'client' | 'personal';
  ids?: string[];
  eager?: boolean;
}

const { kind, ids, eager = false } = Astro.props;
const projects = await getCollection('projects', ({ id, data }) => (ids ? ids.includes(id) : kind ? data.kind === kind : true));

// Screenshots live in src/assets/projects/<id>.jpg; projects without one render without an image.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.jpg', { eager: true });
const shotFor = (id: string) => shots[`../assets/projects/${id}.jpg`]?.default;
---

<div class="posts">
  {projects.map(({ id, data }) => {
    const shot = shotFor(id);
    return (
      <article>
        {shot && <Image src={shot} alt="" width={800} loading={eager ? 'eager' : 'lazy'} style={data.focus ? `object-position: ${data.focus}` : undefined} />}
        <div class="body">
          <h3><a href={data.url}>{data.title}</a></h3>
          <p>{data.description}</p>
          <ul class="tags">
            {data.tags.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </article>
    );
  })}
</div>

<style>
  .posts { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1rem; margin-top: 0.75rem; }
  article {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--muted) 50%, transparent);
    border-radius: 0.5rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }
  article:hover { border-color: var(--link); }
  /* A project without a screenshot only takes the height its text needs. */
  article:not(:has(img)) { align-self: start; }
  @media (prefers-reduced-motion: no-preference) {
    article { transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
    article:hover { transform: translateY(-3px); box-shadow: 0 8px 24px color-mix(in srgb, var(--fg) 12%, transparent); }
    img { transition: transform 0.4s ease; }
    article:hover img { transform: scale(1.03); }
  }
  article:has(a:focus-visible) { outline: 2px solid var(--link); outline-offset: 2px; }

  img { flex: none; display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; }
  .body { padding: 0.55rem 0.75rem 0.7rem; flex: none; display: flex; flex-direction: column; }
  .tags { margin-top: auto; }
  h3 { margin: 0 0 0.2rem; font-size: 1rem; line-height: 1.25; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  h3 a:focus-visible { outline: none; }
  /* Stretched link: the whole card is clickable. */
  h3 a::after { content: ''; position: absolute; inset: 0; }
  p { margin: 0 0 0.5rem; font-size: 0.85rem; line-height: 1.35; }

  /* Fit mode (set by fit-grid.ts): the grid has a definite height; column count comes from JS
     and the screenshot absorbs whatever height the text leaves. */
  :global(html.fit) .posts {
    flex: 1;
    min-height: var(--min-h, 0);
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    grid-auto-rows: minmax(0, 1fr);
    grid-template-rows: var(--rows, none);
  }
  /* Hidden until fit-grid.ts has chosen the columns, so cards never visibly reflow. The animation
     is a safety net: if the script never runs, the grid appears after 1.5s anyway. */
  :global(html.fit) .posts:not([data-fit]) { visibility: hidden; animation: show-grid 0s 1.5s forwards; }
  @keyframes show-grid { to { visibility: visible; } }
  /* In fit mode a text-only card fills its cell instead of leaving dead space below it. */
  :global(html.fit) article:not(:has(img)) { align-self: stretch; }
  :global(html.fit) article:not(:has(img)) .body { flex: 1; justify-content: center; }
  @media (min-width: 90rem) {
    :global(html.fit) article:not(:has(img)) .body { padding: 1rem 1.25rem; }
    :global(html.fit) article:not(:has(img)) .body h3 { font-size: 1.4rem; margin-bottom: 0.4rem; }
    :global(html.fit) article:not(:has(img)) .body p { font-size: 1.05rem; line-height: 1.5; margin-bottom: 0.75rem; }
    :global(html.fit) article:not(:has(img)) .tags { margin-top: 0; }
  }
  /* The image absorbs spare height but is capped at 1.65:1 (source is 16:9) so it never crops much
     horizontally; any further spare height goes to the text area. */
  :global(html.fit) article:has(img) { container-type: inline-size; }
  :global(html.fit) img { flex: 1000 1 0; min-height: 5rem; aspect-ratio: auto; height: auto; max-height: calc(100cqw / 1.65); }
  :global(html.fit) article:has(img) .body { flex: 1 0 auto; }
</style>
