---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import projectsData from '../data/projects.json';

interface Props {
  eager?: boolean;
  heading?: 'h2' | 'h3';
}

const { eager = false, heading: Heading = 'h3' } = Astro.props;
const order = projectsData.map((p) => p.id);
const all = (await getCollection('projects')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));

// Screenshots live in src/assets/projects/<id>.jpg; projects without one get a type-only tile.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.jpg', { eager: true });
const shotFor = (id: string) => shots[`../assets/projects/${id}.jpg`]?.default;
const kinds = { client: 'Client work', personal: 'Personal project' };
---

<ul class="tiles">
  {all.map(({ id, data }, i) => {
    const shot = shotFor(id);
    const first = i === 0;
    return (
      <li class:list={['tile', { noshot: !shot }]}>
        <div class="cap">
          <Heading class="title"><a href={data.url}>{data.title}</a></Heading>
          <ul class="tags">
            {data.tags.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="media">
          <p class="kind">{kinds[data.kind]}</p>
          {shot ? (
            <Image src={shot} alt="" width={1280} widths={[480, 720, 1024, 1280, 1600]} sizes="(min-width: 64rem) 40vw, (min-width: 40rem) 50vw, 100vw" loading={eager && first ? 'eager' : 'lazy'} fetchpriority={eager && first ? 'high' : undefined} decoding={eager && first ? 'sync' : 'async'} style={data.focus ? `object-position: ${data.focus}` : undefined} />
          ) : (
            <span class="notile" aria-hidden="true">{data.title}</span>
          )}
          <p class="desc">{data.description}</p>
        </div>
      </li>
    );
  })}
</ul>

<style>
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--gap); }
  .tile { position: relative; display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; border-radius: var(--radius); background: var(--tile); }
  .media { display: contents; }
  .media img, .notile { order: 1; }
  .cap { order: 2; background: var(--ink); color: var(--on-ink); padding: 0.85rem 1.1rem 1rem; }
  .media img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; }
  .notile { display: grid; place-items: center; aspect-ratio: 16 / 9; padding: 1.5rem; background: var(--lime); color: var(--on-accent); font-size: clamp(2rem, 6vw, 3.5rem); font-weight: 800; letter-spacing: -0.04em; text-align: center; line-height: 1; }
  .desc { order: 3; margin: 0; padding: 1rem 1.1rem 1.1rem; background: var(--tile); color: var(--fg); flex: 1; }

  .title { margin: 0; font-size: 1.25rem; line-height: 1.2; font-weight: 750; letter-spacing: -0.025em; }
  .title a { color: inherit; text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; z-index: 3; }
  .title a:focus-visible { outline: none; }
  .tile:has(a:focus-visible) { outline: 3px solid var(--fg); outline-offset: 2px; }
  .kind { position: absolute; z-index: 2; top: 0.6rem; left: 0.6rem; margin: 0; padding: 0.15rem 0.65rem; border-radius: 99px; background: var(--ink); color: var(--on-ink); font-size: 0.875rem; font-weight: 600; line-height: 1.5; }
  .tags { display: flex; flex-wrap: wrap; gap: 0 0.6rem; margin: 0.3rem 0 0; padding: 0; list-style: none; font-size: 0.9375rem; color: var(--on-ink-muted); }
  .tags li + li::before { content: '/'; margin-right: 0.6rem; color: var(--ink-line); }

  @media (min-width: 40rem) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Desktop bento: the tile is a fixed cell; screenshot fills it, caption sits on a solid strip,
     description covers the screenshot on hover/focus (always in the DOM for assistive tech). */
  @media (min-width: 64rem) and (min-height: 34rem) {
    .tiles { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); height: 100%; min-height: 0; }
    .tile:nth-child(1) { grid-column: 1 / 5; }
    .tile:nth-child(2) { grid-column: 5 / 8; }
    .tile:nth-child(3) { grid-column: 8 / 11; }
    .tile:nth-child(4) { grid-column: 1 / 4; }
    .tile:nth-child(5) { grid-column: 4 / 8; }
    .tile:nth-child(6) { grid-column: 8 / 11; }
    .media img, .notile { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; }
    .cap { padding: 0.6rem 1rem 0.7rem; }
    .title { font-size: clamp(1.125rem, 1.35vw, 1.5rem); }
    .tags { margin-top: 0.15rem; }
    @media (max-width: 80rem) {
      .tags { gap: 0 0.75rem; font-size: 0.875rem; }
      .tags li + li::before { display: none; }
    }
    /* The description covers the whole tile; the title stays readable at the bottom of it. */
    .media { display: block; order: 1; flex: 1; min-height: 0; }
    .desc { order: 0; }
    .media img, .notile { z-index: 0; }
    .desc { position: absolute; inset: 0; z-index: 1; overflow: auto; padding: 1rem 1.1rem 4.75rem; font-size: 1rem; line-height: 1.45; opacity: 0; }
    .cap { position: relative; z-index: 2; }
    .tile:is(:hover, :focus-within) .desc { opacity: 1; }
    .tile:is(:hover, :focus-within) .cap { background: transparent; color: var(--fg); }
    .tile:is(:hover, :focus-within) .tags, .tile:is(:hover, :focus-within) .kind { opacity: 0; }
    .tile:is(:hover, :focus-within) .title { text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 3px; text-underline-offset: 0.2em; }
  }
  @media (min-width: 64rem) and (min-height: 34rem) and (prefers-reduced-motion: no-preference) {
    .desc { transition: opacity 0.15s ease-out; }
    .media img { transition: transform 0.4s ease-out; }
    .tile:is(:hover, :focus-within) .media img { transform: scale(1.03); }
  }
</style>
