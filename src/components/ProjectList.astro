---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import projectsData from '../data/projects.json';

interface Props {
  eager?: boolean;
  heading?: 'h2' | 'h3';
}

const { eager = false, heading: Heading = 'h3' } = Astro.props;
const order = projectsData.map((p) => p.id);
const all = (await getCollection('projects')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));

// Screenshots live in src/assets/projects/<id>.jpg; projects without one get a type-only tile.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.jpg', { eager: true });
const shotFor = (id: string) => shots[`../assets/projects/${id}.jpg`]?.default;
const kinds = { client: 'Client work', personal: 'Personal project' };
---

<ul class="tiles">
  {all.map(({ id, data }, i) => {
    const shot = shotFor(id);
    const first = i === 0;
    return (
      <li class:list={['tile', { noshot: !shot }]}>
        <p class="kind">{kinds[data.kind]}</p>
        {shot ? (
          <Image src={shot} alt="" width={1280} widths={[480, 720, 1024, 1280, 1600]} sizes="(min-width: 64rem) 34vw, (min-width: 40rem) 50vw, 100vw" loading={eager && first ? 'eager' : 'lazy'} fetchpriority={eager && first ? 'high' : undefined} decoding={eager && first ? 'sync' : 'async'} style={data.focus ? `object-position: ${data.focus}` : undefined} />
        ) : (
          <span class="notile" aria-hidden="true">{data.title}</span>
        )}
        <div class="cap">
          <Heading class="title"><a href={data.url}>{data.title}</a></Heading>
          <ul class="tags">
            {data.tags.map((t) => <li>{t}</li>)}
          </ul>
          <p class="desc">{data.description}</p>
        </div>
      </li>
    );
  })}
</ul>

<style>
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--gap); }
  .tile { position: relative; display: flex; flex-direction: column; min-width: 0; min-height: 0; border-radius: var(--radius); background: var(--ink); color: var(--on-ink); outline: 3px solid transparent; outline-offset: 3px; border: 2px solid var(--tile-rule); }
  .tile img, .notile { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: calc(var(--radius) - 2px) calc(var(--radius) - 2px) 0 0; flex: none; }
  .notile { display: grid; place-items: center; padding: 1rem; background: var(--lime); color: var(--on-accent); font-size: clamp(2rem, 6vw, 3.5rem); font-weight: 900; letter-spacing: -0.05em; text-align: center; line-height: 0.95; text-transform: uppercase; }
  .cap { position: relative; flex: 1; padding: 0.8rem 1.1rem 1rem; border-radius: 0 0 calc(var(--radius) - 2px) calc(var(--radius) - 2px); display: flex; flex-direction: column; justify-content: space-between; gap: 0.5rem; }
  .title { margin: 0; font-size: 1.25rem; line-height: 1.15; font-weight: 850; letter-spacing: -0.03em; }
  .title a { color: inherit; text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; z-index: 3; }
  .title a:focus-visible { outline: none; }
  .tile:has(a:focus-visible) { outline-color: var(--blue); }
  .kind { position: absolute; z-index: 2; top: 0.6rem; left: 0.6rem; margin: 0; padding: 0.1rem 0.6rem; border-radius: 0.35rem; background: var(--lime); color: var(--on-accent); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; line-height: 1.6; }
  .tags { display: flex; flex-wrap: wrap; gap: 0 0.7rem; margin: 0; padding: 0.45rem 0 0; border-top: 2px solid var(--ink-line); list-style: none; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; color: var(--on-ink-muted); }
  .desc { margin: 0; font-size: 1rem; line-height: 1.45; }

  @media (min-width: 40rem) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Desktop: 3x2 equal tiles, 16:9 screenshot at the natural ratio, ink caption fills the rest.
     Hover/focus lifts the tile, an offset blue outline appears, and the description rises over the
     lower screenshot as a blue panel. It stays in the DOM (opacity only) for assistive tech. */
  @media (min-width: 64rem) and (min-height: 34rem) {
    .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); height: 100%; min-height: 0; }
    .tile { min-height: 0; }
    .tile img, .notile { flex: 0 1 auto; min-height: 0; }
    .title { font-size: clamp(1.25rem, 1.5vw, 2rem); }
    .cap { overflow: visible; padding: 0.65rem 1rem 0.75rem; }
    .desc { position: absolute; left: 0; right: 0; bottom: 100%; margin: 0; padding: 0.9rem 1rem 0.8rem; background: var(--blue); color: var(--on-blue); font-size: 0.9375rem; font-weight: 500; opacity: 0; pointer-events: none; }
    .tile:is(:hover, :focus-within) { transform: translateY(-4px); outline-color: var(--blue); z-index: 2; }
    .tile:is(:hover, :focus-within) .desc { opacity: 1; }
    .tile:is(:hover, :focus-within) .cap { background: var(--blue); color: var(--on-blue); }
    .tile:is(:hover, :focus-within) .tags { border-top-color: rgb(255 255 255 / 0.6); }
    .tile:is(:hover, :focus-within) .tags { color: var(--on-blue); }
  }
  /* Short desktops: keep the 16:9 screenshot whole by tightening the caption. */
  @media (min-width: 64rem) and (min-height: 34rem) and (max-height: 52rem) {
    .title { font-size: clamp(1rem, 1.3vw, 1.2rem); line-height: 1.1; }
    .cap { padding: 0.3rem 0.8rem 0.4rem; gap: 0.15rem; }
    .tags { font-size: 0.6875rem; gap: 0 0.5rem; padding-top: 0.2rem; flex-wrap: nowrap; white-space: nowrap; letter-spacing: 0.03em; }
    .desc { font-size: 0.875rem; padding: 0.7rem 0.8rem; }
  }
  /* Projects page on tall desktops: the caption has room, so the description is simply shown. */
  @media (min-width: 64rem) and (min-height: 52.0625rem) {
    :global(.projects) .cap { justify-content: flex-start; gap: 0.5rem; }
    :global(.projects) .desc { position: static; opacity: 1; pointer-events: auto; background: none; color: inherit; padding: 0; order: 2; font-size: 0.9375rem; color: var(--on-ink-muted); }
    :global(.projects) .tags { order: 3; margin-top: auto; }
    :global(.projects) .tile:is(:hover, :focus-within) .desc { color: var(--on-blue); }
  }
  @media (min-width: 64rem) and (min-height: 34rem) and (prefers-reduced-motion: no-preference) {
    .tile { transition: transform 0.15s ease-out, outline-color 0.15s; }
    .desc { transition: opacity 0.15s ease-out; }
  }
</style>
