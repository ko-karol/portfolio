---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import projectsData from '../data/projects.json';

interface Props {
  eager?: boolean;
  groups?: boolean;
  compact?: boolean;
}

const { eager = false, groups = false, compact = false } = Astro.props;
const order = projectsData.map((p) => p.id);
const all = (await getCollection('projects')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));

// Screenshots live in src/assets/projects/<id>.jpg; projects without one get a text tile in the preview.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.jpg', { eager: true });
const shotFor = (id: string) => shots[`../assets/projects/${id}.jpg`]?.default;

const sections = groups
  ? [
      { label: 'Client work', items: all.filter((p) => p.data.kind === 'client') },
      { label: 'Personal projects', items: all.filter((p) => p.data.kind === 'personal') },
    ]
  : [{ label: '', items: all }];

// Row template of the desktop list column (groups mode): heading, group label, rows, group label, rows.
const rows = `auto ${sections.map((s) => `auto repeat(${s.items.length}, minmax(0, 1fr))`).join(' ')}`;
---

<div class:list={['index', { compact, groups }]} style={groups ? `--rows:${rows}` : undefined}>
  <slot />
  {sections.map(({ label, items }) => (
    <>
      {label && <h2 class="group">{label}</h2>}
      <ol class="rows">
        {items.map(({ id, data }) => {
          const shot = shotFor(id);
          const first = all[0].id === id;
          return (
            <li class="row">
              {shot ? (
                <a class="pv shot" href={data.url} tabindex="-1" aria-hidden="true">
                  <Image src={shot} alt="" width={1280} widths={[480, 720, 1024, 1280, 1600]} sizes="(min-width: 64rem) 70vw, (min-width: 40rem) 50vw, 100vw" loading={eager && first ? 'eager' : 'lazy'} fetchpriority={eager && first ? 'high' : undefined} decoding={eager && first ? 'sync' : 'async'} style={data.focus ? `object-position: ${data.focus}` : undefined} />
                </a>
              ) : (
                <div class="pv shot noshot" aria-hidden="true">{data.title}</div>
              )}
              <h3 class="title"><a href={data.url}>{data.title}</a></h3>
              <div class="pv cap">
                <p class="desc">{data.description}</p>
                <ul class="tags">
                  {data.tags.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            </li>
          );
        })}
      </ol>
    </>
  ))}
</div>

<style>
  .index { counter-reset: row; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem 1.5rem; }
  .index > :global(h1), .group { grid-column: 1 / -1; }
  .group { margin: 0.5rem 0 -1rem; font-size: 1.25rem; font-weight: 600; color: var(--muted); letter-spacing: -0.01em; }
  .rows { display: contents; list-style: none; margin: 0; padding: 0; }

  /* Phone / tablet: image, then title, then caption. */
  .row { display: flex; flex-direction: column; min-width: 0; }
  .shot { order: -1; display: block; position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 2px; background: var(--surface); }
  .shot img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .noshot { display: none; }
  .title { counter-increment: row; margin: 1rem 0 0; font-size: 1.5rem; line-height: 1.2; font-weight: 650; letter-spacing: -0.02em; }
  .title a { color: var(--fg); text-decoration: none; }
  .title a::after { content: ' \2197'; color: var(--accent); }
  .title a:hover { color: var(--accent); }
  .cap { margin-top: 0.5rem; }
  .desc { margin: 0 0 0.75rem; color: var(--muted); max-width: 40rem; }
  .cap .tags { color: var(--fg); }

  @media (min-width: 40rem) {
    .index { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem 2rem; }
  }

  /* Desktop: one large preview, list or filmstrip beside/below it. Hover or focus picks the preview, first by default. */
  @media (min-width: 64rem) and (min-height: 34rem) {
    .index { height: 100%; min-height: 0; grid-template-columns: minmax(0, 1fr) clamp(18rem, 22vw, 26rem); grid-template-rows: var(--rows); gap: 0 clamp(2rem, 3.5vw, 4rem); }
    .row { display: contents; }
    .index > :global(h1), .group { grid-column: 2; }
    .group { margin: 0; align-self: end; padding-bottom: 0.4rem; font-size: 1rem; }
    .pv { grid-column: 1; grid-row: 1 / -1; visibility: hidden; opacity: 0; }
    .shot { order: 0; aspect-ratio: auto; min-height: 0; }
    .shot img { position: absolute; inset: 0; }
    .noshot { display: grid; place-items: center; padding: 2rem; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 700; letter-spacing: -0.03em; color: var(--muted); text-align: center; }
    .cap { position: relative; z-index: 1; align-self: end; margin: 0; padding: 1.25rem 1.5rem; background: rgb(8 8 9 / 0.86); color: #f3f2ef; }
    .cap .desc { color: #d6d6da; max-width: 46rem; margin-bottom: 0.5rem; }
    .cap .tags { color: #f3f2ef; }
    .row:is(:hover, :focus-within) .pv,
    .rows:first-of-type .row:first-child .pv { visibility: visible; opacity: 1; }
    .index:has(.row:is(:hover, :focus-within)) .rows:first-of-type .row:first-child:not(:hover, :focus-within) .pv { visibility: hidden; opacity: 0; }

    .title { grid-column: 2; position: relative; display: flex; align-items: center; margin: 0; border-top: 1px solid var(--line); font-size: clamp(1.25rem, 1.7vw, 1.6rem); }
    .title::before { content: counter(row, decimal-leading-zero) / ''; width: 2.5rem; flex: none; font-size: 0.9rem; font-weight: 500; letter-spacing: 0; color: var(--muted); font-variant-numeric: tabular-nums; }
    .title a { flex: 1; }
    .title a::after { position: absolute; inset: 0; text-align: right; padding-right: 0.25rem; line-height: 1; display: flex; align-items: center; justify-content: flex-end; opacity: 0; }
    .title a:focus-visible { outline: none; }
    .title:has(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
    .row:is(:hover, :focus-within) .title { border-top-color: var(--accent); }
    .row:is(:hover, :focus-within) .title a::after { opacity: 1; }
    .row:is(:hover, :focus-within) .title::before { color: var(--accent); }
    .index:not(:has(.row:is(:hover, :focus-within))) .rows:first-of-type .row:first-child .title { border-top-color: var(--accent); }
    .index:not(:has(.row:is(:hover, :focus-within))) .rows:first-of-type .row:first-child .title::before { color: var(--accent); }

    /* Home: filmstrip of titles under the preview. */
    .compact { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: minmax(0, 1fr) auto auto; gap: 0 1.5rem; }
    .compact .pv { grid-column: 1 / -1; grid-row: 1; }
    .compact .title { grid-column: auto; padding: 0.7rem 0; font-size: clamp(1.05rem, 1.25vw, 1.25rem); }
    .compact .row:nth-child(-n + 3) .title { margin-top: 1rem; }
    .compact .title::before { width: 2rem; }
    .compact .title a::after { display: none; }
  }

  @media (min-width: 64rem) and (min-height: 34rem) and (prefers-reduced-motion: no-preference) {
    .pv { transition: opacity 0.18s ease-out, visibility 0.18s; }
  }
</style>
