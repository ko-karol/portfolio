---
const { title, url, author, date, tags, commentary } = Astro.props;
---
<article class="project-card">
  <div class="card-fold"></div>
  
  <header class="card-header">
    <div class="card-label">{author}</div>
    <div class="card-dots">
      <span></span><span></span><span></span>
    </div>
  </header>
  
  <h3 class="card-title">{title}</h3>
  
  {commentary && (
    <blockquote class="card-desc">
      {commentary}
    </blockquote>
  )}

  <div class="card-metrics">
    <div class="metric">
        <span class="metric-val"><time datetime={date}>{new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time></span>
        <span class="metric-label">Published</span>
    </div>
  </div>

  <footer class="card-footer">
    {tags && tags.length > 0 && (
        <div class="card-tags">
          {tags.map((tag: string) => <span class="tag">{tag}</span>)}
        </div>
    )}
    <a href={url} target="_blank" rel="noopener noreferrer" class="card-cta">
      Read Article →
    </a>
  </footer>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--paper-white);
    border: 2.5px solid var(--ink-900);
    border-radius: var(--radius);
    padding: 1.75rem 1.5rem 1.5rem;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .card-fold {
    position: absolute;
    top: 0;
    right: 0;
    width: 28px;
    height: 28px;
    background: linear-gradient(225deg, var(--paper-tan) 50%, transparent 50%);
    border-left: 1.5px solid var(--paper-warm);
    border-bottom: 1.5px solid var(--paper-warm);
    z-index: 2;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-300);
    border: 1.5px solid var(--ink-100);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius);
    background: var(--paper-cream);
  }

  .card-dots {
    display: flex;
    gap: 0.3rem;
  }

  .card-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--paper-tan);
  }

  .card-dots span:nth-child(1) { background: #f5a0a0; }
  .card-dots span:nth-child(2) { background: var(--yellow); }
  .card-dots span:nth-child(3) { background: #8acc8a; }

  .card-title {
    font-size: 1.25rem;
    letter-spacing: -0.025em;
    font-weight: 700;
  }

  .card-desc {
    flex-grow: 1;
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink-700);
    border-left: 3px solid var(--ink-100);
    padding-left: var(--space-sm);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .card-metrics {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-top: 1.5px dashed var(--ink-100);
    border-bottom: 1.5px dashed var(--ink-100);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .metric-val {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink-900);
    line-height: 1;
  }

  .metric-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-300);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: auto;
  }

  .card-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.68rem;
    font-weight: 600;
    background: var(--paper-cream);
    border: 1.5px solid var(--paper-tan);
    border-radius: var(--radius);
    padding: 0.12rem 0.45rem;
    color: var(--ink-500);
  }

  .card-cta {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-900);
    white-space: nowrap;
    border-bottom: 2px solid var(--ink-900);
    padding-bottom: 1px;
    margin-left: auto;
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }

  .card-cta:hover {
    color: var(--red);
    border-color: var(--red);
  }
</style>
