---
import CardFold from '../components/ui/CardFold.astro';

const skills = ['JavaScript', 'TypeScript', 'React', 'Astro', 'SQLite', 'NixOS', 'Docker'];
---

<section class="section about-section" id="about" aria-labelledby="about-heading">
  <div class="container">
    <div class="about-layout">
      <div class="about-left reveal">
        <header class="section-header">
          <h2 class="section-title" id="about-heading">
            Full-stack <span class="title-highlight">developer</span>.
          </h2>
        </header>
        <div class="about-bio">
          <p>
            I build clean, resilient web applications. Founders &amp; Coders graduate, formerly freelance for charitable organizations.
          </p>
          <p class="pi-note">
            I work with AI coding agents (Pi) for rapid prototyping and boilerplate generation—always with human oversight for architecture decisions, code review, and quality assurance.
          </p>
        </div>
        <div class="about-skills" aria-label="Skills">
          {skills.map(skill => <span class="skill-chip">{skill}</span>)}
        </div>
      </div>

      <div class="about-right reveal">
        <div class="about-photo-card">
          <CardFold />
          <div class="about-photo" aria-label="Karol">K</div>
          <div class="about-photo-caption">
            <span>Karol</span>
            <span class="caption-role">Available for work</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: var(--space-2xl) 0 calc(var(--space-2xl) + 4vw);
    position: relative;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .section-header {
    margin-bottom: 3.5rem;
  }

  .section-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-300);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .title-highlight {
    position: relative;
    display: inline-block;
  }

  .title-highlight::after {
    content: '';
    position: absolute;
    left: -0.1em;
    right: -0.1em;
    bottom: 0.05em;
    height: 0.35em;
    background: var(--yellow);
    z-index: -1;
    transform: rotate(-0.5deg);
  }

  .about-section {
    background: rgba(237, 232, 223, 0.88);
    z-index: 6;
    padding: var(--space-2xl) 0;
  }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .about-bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .about-bio p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-700);
  }

  .pi-note {
    font-size: 0.9rem;
    padding: 0.75rem 1rem;
    background: var(--paper-white);
    border-left: 3px solid var(--yellow);
    color: var(--ink-600);
  }

  .about-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-chip {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.28rem 0.7rem;
    border: 2px solid var(--ink-900);
    border-radius: var(--radius);
    background: var(--paper-white);
    box-shadow: 2px 2px 0 var(--ink-900);
    transition:
      transform var(--dur) var(--ease-spring),
      box-shadow var(--dur) var(--ease-out),
      background var(--dur-fast);
    cursor: default;
  }

  .skill-chip:hover {
    transform: translate(-1px,-1px);
    box-shadow: 3px 3px 0 var(--ink-900);
    background: var(--yellow);
  }

  .about-photo-card {
    position: relative;
    background: var(--paper-white);
    border: 2.5px solid var(--ink-900);
    border-radius: var(--radius);
    padding: var(--space-lg);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .about-photo {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    background: var(--red);
    color: #fff;
    font-size: 2.4rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    border: 2.5px solid var(--ink-900);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transform: rotate(-2deg);
  }

  .about-photo-caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .about-photo-caption span:first-child {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .caption-role {
    font-size: 0.8rem;
    color: var(--ink-300);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .about-photo-card {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
