---
import CardFold from '../components/ui/CardFold.astro';
import CardTape from '../components/ui/CardTape.astro';
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
  <div class="hero-headline">
    <h1 class="hero-display" id="hero-heading">
      <span class="line">Hey, I'm</span>
      <span class="line"><span class="title-highlight">Karol.</span></span>
      <span class="line accent">Full&#8209;Stack</span>
      <span class="line accent">Developer.</span>
    </h1>
  </div>

  <div class="hero-cred reveal">
    <div class="cred-card">
      <CardTape color="red" position="left" />
      <CardFold />

      <p class="hero-eyebrow">
        <span class="eyebrow-dot"></span>
        Available for work
      </p>

      <p class="hero-stack">TypeScript · React · Node.js · AI-Augmented</p>

      <div class="hero-facts">
        <div class="fact">
          <span class="fact-val">3yr</span>
          <span class="fact-label">Freelance</span>
        </div>
        <div class="fact">
          <span class="fact-val">F&amp;C</span>
          <span class="fact-label">Graduate</span>
        </div>
        <div class="fact">
          <span class="fact-val">UK</span>
          <span class="fact-label">Remote</span>
        </div>
      </div>

      <nav class="hero-links" aria-label="Profile links">
        <a href="https://github.com/ko-karol" class="hero-link" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/ko-karol/" class="hero-link" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href="#work" class="hero-link cta">See work ↓</a>
      </nav>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 80vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
    padding: 6rem clamp(2rem, 7vw, 8rem) calc(3rem + 6vw);
    background-color: var(--paper-cream);
    background-image: radial-gradient(var(--ink-300) 1.5px, transparent 1.5px);
    background-size: 28px 28px;
    z-index: 10;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 6vw), 0 100%);
  }

  .hero-display {
    font-size: clamp(3.8rem, 9vw, 8.5rem);
    line-height: 1.0;
    letter-spacing: -0.04em;
    font-weight: 700;
  }

  .hero-display .line { display: block; }

  .hero-display .accent {
    color: var(--red);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .title-highlight {
    position: relative;
    display: inline-block;
  }

  .title-highlight::after {
    content: '';
    position: absolute;
    left: -0.1em;
    right: -0.1em;
    bottom: 0.05em;
    height: 0.35em;
    background: var(--yellow);
    z-index: -1;
    transform: rotate(-0.5deg);
  }

  .hero-cred {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .cred-card {
    position: relative;
    background: var(--paper-white);
    border: 2.5px solid var(--ink-900);
    border-radius: var(--radius-lg);
    padding: 2rem 2rem 2rem 2.25rem;
    box-shadow: var(--shadow-md);
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transform: rotate(-0.5deg);
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--green);
  }

  .eyebrow-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  .hero-stack {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-700);
    letter-spacing: 0.02em;
  }

  .hero-facts {
    display: flex;
    gap: var(--space-lg);
    padding: 0.85rem 0;
    border-top: 1.5px dashed var(--ink-100);
    border-bottom: 1.5px dashed var(--ink-100);
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .fact-val {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1;
    color: var(--ink-900);
  }

  .fact-label {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-300);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .hero-link {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-700);
    padding: 0.32rem 0.7rem;
    border: 1.5px solid var(--paper-tan);
    border-radius: var(--radius);
    background: var(--paper-cream);
    transition:
      border-color var(--dur-fast),
      color var(--dur-fast),
      box-shadow var(--dur) var(--ease-spring),
      transform var(--dur) var(--ease-spring);
  }

  .hero-link:hover {
    border-color: var(--ink-900);
    color: var(--ink-900);
    box-shadow: 2px 2px 0 var(--ink-900);
    transform: translate(-1px, -1px);
  }

  .hero-link.cta {
    background: var(--red);
    color: #fff;
    border-color: var(--ink-900);
    box-shadow: 3px 3px 0 var(--ink-900);
  }

  .hero-link.cta:hover {
    color: #fff;
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--ink-900);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 6rem 1.5rem calc(2.5rem + 6vw);
    }
  }
</style>
