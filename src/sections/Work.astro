---
import ProjectCard from '../components/ProjectCard.astro';
import CardFold from '../components/ui/CardFold.astro';
import Button from '../components/ui/Button.astro';

const clientProjects = [
  {
    project: 'toast',
    label: 'Client Site',
    title: 'Toast Collective',
    description: 'Film production website for nonprofits. Custom WordPress theme with portfolio gallery and testimonial carousel.',
    tags: ['WordPress', 'PHP', 'CSS'],
    link: 'https://toastcollective.co.uk',
    tapeColor: 'yellow' as const
  },
  {
    project: 'guild',
    label: 'Client Site',
    title: 'Guild of Psychotherapists',
    description: 'Membership site with therapist search, member portal, and training course management. Migrated from SilverStripe to WordPress.',
    tags: ['WordPress', 'Migration', 'Custom Search'],
    link: 'https://guildofpsychotherapists.org.uk',
    tapeColor: 'green' as const
  },
  {
    project: 'claire',
    label: 'Client Site',
    title: 'Claire Lynch Consulting',
    description: 'Business and human rights advisory site. Responsive landing pages with service breakdowns and contact flows.',
    tags: ['WordPress', 'Responsive'],
    link: 'https://clairelynchconsulting.com',
    tapeColor: 'blue' as const
  },
  {
    project: 'rehabit',
    label: 'Client Site',
    title: 'Rehabit UK',
    description: 'Addiction counseling charity site. Streamlined referral form UX and volunteer application system.',
    tags: ['WordPress', 'Forms', 'UX'],
    link: 'https://rehabit.uk',
    tapeColor: 'purple' as const
  }
];

const personalProjects = [
  {
    project: 'repwise',
    label: 'Personal Project',
    title: 'Repwise',
    description: 'React Native app for tracking strength training. Natural language input for quick workout logging. Works offline.',
    tags: ['React Native', 'TypeScript', 'SQLite'],
    tapeColor: 'red' as const
  },
  {
    project: 'lifeofdeath',
    label: 'Experiment',
    title: 'Life of Death',
    description: 'Interactive web tribute for an animated short. No frameworks — just semantic HTML, CSS animations, and careful pacing.',
    tags: ['HTML', 'CSS', 'JavaScript'],
    tapeColor: 'blue' as const
  }
];
---

<section class="section work-section" id="work" aria-labelledby="work-heading">
  <div class="container">
    <header class="section-header reveal">
      <h2 class="section-title" id="work-heading">
        Things I've <span class="title-highlight">built</span>.
      </h2>
    </header>

    <div class="project-layout" id="project-layout">
      <div class="project-list" id="project-list">
        <h3 class="project-group-heading reveal">Client Work</h3>
        {clientProjects.map(p => <ProjectCard {...p} />)}
        <h3 class="project-group-heading reveal">Personal Projects</h3>
        {personalProjects.map(p => <ProjectCard {...p} />)}
      </div>

      <div class="project-detail" id="project-detail" aria-hidden="true">
        <div class="project-detail-inner">
          <CardFold />
          <button class="project-detail-back" id="project-detail-back" aria-label="Close project detail">
            ← Back to projects
          </button>
          <p class="detail-eyebrow" id="detail-eyebrow"></p>
          <h2 class="detail-title" id="detail-title"></h2>
          <p class="detail-desc" id="detail-desc"></p>
          <div class="detail-metrics" id="detail-metrics"></div>
          <h3 class="detail-section-title">Context</h3>
          <p class="detail-body" id="detail-problem"></p>
          <h3 class="detail-section-title">What I did</h3>
          <p class="detail-body" id="detail-solution"></p>
          <h3 class="detail-section-title">Result</h3>
          <p class="detail-body" id="detail-outcome"></p>
          <footer class="detail-footer">
            <div class="detail-tags" id="detail-tags"></div>
            <Button href="#" external id="detail-link">View project ↗</Button>
          </footer>
        </div>
      </div>
    </div>

    <!-- Mobile Modal -->
    <div class="modal-backdrop" id="modal-backdrop" aria-hidden="true">
      <div class="modal" id="modal" aria-hidden="true" role="dialog" aria-modal="true">
        <button class="modal-close" id="modal-close" aria-label="Close">
          <span aria-hidden="true">×</span>
        </button>
        <div class="modal-content">
          <p class="detail-eyebrow" id="sheet-eyebrow"></p>
          <h2 class="detail-title" id="sheet-title"></h2>
          <p class="detail-desc" id="sheet-desc"></p>
          <div class="detail-metrics" id="sheet-metrics"></div>
          <h3 class="detail-section-title">Context</h3>
          <p class="detail-body" id="sheet-problem"></p>
          <h3 class="detail-section-title">What I did</h3>
          <p class="detail-body" id="sheet-solution"></p>
          <h3 class="detail-section-title">Result</h3>
          <p class="detail-body" id="sheet-outcome"></p>
          <footer class="detail-footer">
            <div class="detail-tags" id="sheet-tags"></div>
            <Button href="#" external id="sheet-link">View project ↗</Button>
          </footer>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: var(--space-2xl) 0 calc(var(--space-2xl) + 4vw);
    background: rgba(237, 232, 223, 0.88);
    backdrop-filter: blur(2px);
    position: relative;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .section-header {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .title-highlight {
    position: relative;
    display: inline-block;
  }

  .title-highlight::after {
    content: '';
    position: absolute;
    left: -0.1em;
    right: -0.1em;
    bottom: 0.05em;
    height: 0.35em;
    background: var(--yellow);
    z-index: -1;
    transform: rotate(-0.5deg);
  }

  .section-sub {
    font-size: 1rem;
    color: var(--ink-500);
    max-width: 520px;
  }

  .work-section {
    z-index: 8;
    padding: var(--space-2xl) 0;
  }

  .project-layout {
    display: flex;
    align-items: stretch;
    gap: 0;
    overflow: hidden;
  }

  .project-list {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-content: start;
    min-width: 0;
  }

  .project-list :global(.project-card) {
    flex: 1 1 300px;
  }

  .project-group-heading {
    flex: 1 1 100%;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink-600);
    margin: 1.5rem 0 0.5rem;
  }

  .project-group-heading:first-child {
    margin-top: 0;
  }

  .project-detail {
    width: 0;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--paper-white);
    border-left: 2.5px solid var(--ink-900);
    position: relative;
    opacity: 0;
  }

  .project-detail-inner {
    width: 460px;
    padding: 2rem 2rem 2.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: relative;
    overflow-y: auto;
    max-height: 80vh;
  }

  .project-detail-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-500);
    border: 1.5px solid var(--paper-tan);
    border-radius: var(--radius);
    padding: 0.28rem 0.65rem;
    background: var(--paper-cream);
    align-self: flex-start;
    cursor: pointer;
    transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
  }

  .project-detail-back:hover {
    color: var(--ink-900);
    border-color: var(--ink-900);
    background: var(--paper-white);
  }

  .detail-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-300);
  }

  .detail-title {
    font-size: 1.6rem;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .detail-desc {
    font-size: 0.9rem;
    color: var(--ink-500);
    line-height: 1.65;
  }

  .detail-metrics {
    display: flex;
    gap: var(--space-lg);
    padding: var(--space-sm) 0;
    border-top: 1.5px dashed var(--ink-100);
    border-bottom: 1.5px dashed var(--ink-100);
  }

  .detail-section-title {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-300);
  }

  .detail-body {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--ink-700);
  }

  .detail-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1.5px dashed var(--ink-100);
    margin-top: auto;
  }

  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  /* Mobile modal */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(22, 18, 14, 0.7);
    backdrop-filter: blur(3px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .modal {
    width: 100%;
    max-width: 520px;
    max-height: 85vh;
    background: var(--paper-white);
    border: 3px solid var(--ink-900);
    border-radius: var(--radius);
    box-shadow: 0 25px 50px -12px rgba(22, 18, 14, 0.35);
    transform: scale(0.95);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .modal.is-open {
    opacity: 1;
    transform: scale(1);
  }

  .modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border: 2px solid var(--ink-900);
    border-radius: 50%;
    background: var(--paper-white);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
    z-index: 2;
  }

  .modal-close:hover { background: var(--paper-cream); }

  .modal-content {
    padding: 1.5rem;
    overflow-y: auto;
  }

  @media (min-width: 769px) {
    .modal,
    .modal-backdrop { display: none !important; }
  }

  @media (max-width: 768px) {
    .project-layout { flex-direction: column; overflow: visible; }
    .project-detail { display: none !important; }
  }
</style>
