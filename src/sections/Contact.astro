---
import CardFold from '../components/ui/CardFold.astro';
import CardTape from '../components/ui/CardTape.astro';
import Button from '../components/ui/Button.astro';
---

<section class="section contact-section" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="contact-layout">
      <div class="contact-left reveal">
        <p class="section-eyebrow">Get in touch</p>
        <h2 class="contact-title" id="contact-heading">
          Let's build<br>something great.
        </h2>
        <p class="contact-sub">
          Whether you have a project in mind, want to chat about an opportunity, or just want to say hi — my inbox is open.
        </p>
        <Button href="mailto:karol@ko-karol.com" size="large">
          <span>karol@ko-karol.com</span>
          <span aria-hidden="true">→</span>
        </Button>
        <div class="contact-links" role="list" aria-label="Social links">
          <a href="https://github.com/ko-karol" class="contact-social" target="_blank" rel="noopener" role="listitem">GitHub</a>
          <span class="contact-sep" aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/ko-karol/" class="contact-social" target="_blank" rel="noopener" role="listitem">LinkedIn</a>
        </div>
      </div>

      <div class="contact-right reveal">
        <div class="contact-card">
          <CardFold />
          <CardTape color="red" />
          <form class="contact-form" id="contact-form" novalidate>
            <div class="form-group">
              <label for="form-name">Name</label>
              <input id="form-name" name="name" type="text" autocomplete="name" placeholder="Your name" required />
            </div>
            <div class="form-group">
              <label for="form-email">Email</label>
              <input id="form-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
            </div>
            <div class="form-group">
              <label for="form-message">Message</label>
              <textarea id="form-message" name="message" rows="4" placeholder="Tell me about your project…" required></textarea>
            </div>
            <Button variant="primary" block>Send message</Button>
            <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: var(--space-2xl) 0 calc(var(--space-2xl) + 4vw);
    position: relative;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .section-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-300);
    margin-bottom: 0.75rem;
  }

  .contact-section {
    background: rgba(22, 18, 14, 0.92);
    color: var(--paper-white);
    backdrop-filter: blur(3px);
    z-index: 5;
    margin-top: -6vw;
    padding-top: calc(var(--space-2xl) + 6vw);
  }

  .contact-section .section-eyebrow { color: var(--ink-300); }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--paper-white);
    margin-bottom: var(--space-md);
  }

  .contact-sub {
    color: var(--ink-300);
    font-size: 0.95rem;
    margin-bottom: var(--space-xl);
    max-width: 380px;
  }

  .contact-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--space-lg);
  }

  .contact-social {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-300);
    border-bottom: 1.5px solid transparent;
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }

  .contact-social:hover { color: var(--paper-white); border-color: var(--red); }

  .contact-sep { color: var(--ink-500); }

  .contact-card {
    position: relative;
    background: var(--paper-white);
    border: 2.5px solid var(--ink-900);
    border-radius: var(--radius);
    padding: 2rem;
    box-shadow: var(--shadow-md);
    color: var(--ink-900);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-500);
  }

  .form-group input,
  .form-group textarea {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    padding: 0.6rem 0.85rem;
    background: var(--paper-cream);
    border: 2px solid var(--ink-900);
    border-radius: var(--radius);
    color: var(--ink-900);
    resize: vertical;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
    outline: none;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(40,96,160,0.2);
  }

  .form-status {
    font-size: 0.82rem;
    text-align: center;
    min-height: 1.2em;
    color: var(--green);
  }

  @media (max-width: 900px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
