---
import Layout from '../../layouts/Layout.astro';
import SignalPost from '../../components/SignalPost.astro';

const posts = [
  {
    title: 'Yes, and...',
    url: 'https://htmx.org/essays/yes-and/',
    author: 'Carson Gross',
    date: '2026-02-27',
    commentary: `A thoughtful piece on the future of programming in the age of AI. Gross argues that while AI can generate code, the core skills of problem-solving, complexity management, and understanding the code you ship will become even more valuable. His take: "You have to write the code."`,
    tags: ['AI', 'Software Development', 'Career'],
  },
  // Add new signal boosts here in the future
];
---

<Layout title="Signal | Karol">
  <main id="main" class="signal-page">
    <div class="container">
      <header class="section-header">
        <p class="section-eyebrow">Signal</p>
        <h1 class="section-title">
          Valuable <span class="title-highlight">Reads</span>
        </h1>
        <p class="section-sub">
          A curated collection of articles, essays, and resources I've found insightful. New additions will appear here.
        </p>
      </header>

      <div class="post-grid">
        {posts.map(post => (
          <SignalPost
            title={post.title}
            url={post.url}
            author={post.author}
            date={post.date}
            commentary={post.commentary}
            tags={post.tags}
          />
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .signal-page {
    padding: var(--space-2xl) 0 calc(var(--space-2xl) + 4vw);
    background: rgba(237, 232, 223, 0.88);
    backdrop-filter: blur(2px);
    margin-top: 4rem;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .section-header {
    margin-bottom: 3.5rem;
  }

  .section-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-300);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .title-highlight {
    position: relative;
    display: inline-block;
  }

  .title-highlight::after {
    content: '';
    position: absolute;
    left: -0.1em;
    right: -0.1em;
    bottom: 0.05em;
    height: 0.35em;
    background: var(--yellow);
    z-index: -1;
    transform: rotate(-0.5deg);
  }

  .section-sub {
    font-size: 1rem;
    color: var(--ink-500);
    max-width: 520px;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-lg);
  }
</style>
