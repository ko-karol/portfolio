---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Karol | Full-Stack Developer">
  <main id="main">

    <!-- ── HERO (masthead — get in, establish signal, get out) ── -->
    <section class="hero" id="hero" aria-labelledby="hero-heading">

      <div class="hero-headline">
        <h1 class="hero-display" id="hero-heading">
          <span class="line">Hey, I'm</span>
          <span class="line"><span class="title-highlight">Karol.</span></span>
          <span class="line hero-display--accent">Full&#8209;Stack</span>
          <span class="line hero-display--accent">Developer.</span>
        </h1>
      </div>

      <!-- Compact credential card — no floating decorations -->
      <div class="hero-cred reveal">
        <div class="hero-cred-card">
          <div class="card-tape card-tape--red" style="left: 1.5rem; translate: none;"></div>
          <div class="card-fold"></div>

          <p class="hero-eyebrow">
            <span class="eyebrow-dot"></span>
            Available for work
          </p>

          <p class="hero-stack">TypeScript · React · Node.js · AI-Augmented</p>

          <div class="hero-facts">
            <div class="hero-fact">
              <span class="fact-val">3yr</span>
              <span class="fact-label">Freelance</span>
            </div>
            <div class="hero-fact">
              <span class="fact-val">F&amp;C</span>
              <span class="fact-label">Graduate</span>
            </div>
            <div class="hero-fact">
              <span class="fact-val">UK</span>
              <span class="fact-label">Remote</span>
            </div>
          </div>

          <nav class="hero-links" aria-label="Profile links">
            <a href="https://github.com/ko-karol" class="hero-link"
               target="_blank" rel="noopener">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/ko-karol/" class="hero-link"
               target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href="#work" class="hero-link hero-link--cta">See work ↓</a>
          </nav>
        </div>
      </div>

    </section>

    <!-- ── CURRENTLY STRIP ─────────────────────────────────────── -->
    <div class="currently-strip" aria-label="Currently">
      <div class="tape tape--left"></div>
      <div class="tape tape--right"></div>
      <div class="currently-content">
        <span class="currently-label">Now</span>
        <span class="currently-item">Reading <em>SICP</em></span>
        <span class="currently-dot">·</span>
        <span class="currently-item">Building a NixOS home server</span>
        <span class="currently-dot">·</span>
        <span class="currently-item">Learning systems design patterns</span>
      </div>
    </div>

    <!-- ── WORK / PROJECTS ────────────────────────────────────── -->
    <section class="section" id="work" aria-labelledby="work-heading">
      <div class="container">
        <header class="section-header reveal">
          <p class="section-eyebrow">Selected work</p>
          <h2 class="section-title" id="work-heading">
            Things I've <span class="title-highlight">built</span>.
          </h2>
          <p class="section-sub">Client sites, personal projects, experiments.</p>
        </header>

        <!--
          project-layout: flex container that reshapes when a project is selected.
          project-list: compresses to a narrow column (GSAP animates width).
          project-detail: expands inline within the same section (not an overlay).
        -->
        <div class="project-layout" id="project-layout">

          <div class="project-list" id="project-list">

            <!-- ── CLIENT WORK ─────────────────────────────────────── -->
            <h3 class="project-group-heading reveal">Client Work</h3>

            <!-- Client: Toast Collective -->
            <article class="project-card reveal client-project"
                     data-project="toast"
                     role="button" tabindex="0"
                     aria-label="Open Toast Collective project detail">
              <div class="card-tape card-tape--yellow"></div>
              <div class="card-fold"></div>
              <header class="card-header">
                <span class="card-label">Client Site</span>
                <div class="card-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              </header>
              <h3 class="card-title">Toast Collective</h3>
              <p class="card-desc">
                Film production website for nonprofits. Custom WordPress theme with portfolio gallery and testimonial carousel.
              </p>
              <footer class="card-footer">
                <div class="card-tags">
                  <span class="tag">WordPress</span>
                  <span class="tag">PHP</span>
                  <span class="tag">CSS</span>
                </div>
                <a href="https://toastcollective.co.uk" target="_blank" rel="noopener" class="card-cta" onclick="event.stopPropagation();">Visit ↗</a>
              </footer>
            </article>

            <!-- Client: Guild of Psychotherapists -->
            <article class="project-card reveal client-project"
                     data-project="guild"
                     role="button" tabindex="0"
                     aria-label="Open Guild of Psychotherapists project detail">
              <div class="card-tape card-tape--green"></div>
              <div class="card-fold"></div>
              <header class="card-header">
                <span class="card-label">Client Site</span>
                <div class="card-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              </header>
              <h3 class="card-title">Guild of Psychotherapists</h3>
              <p class="card-desc">
                Membership site with therapist search, member portal, and training course management. Migrated from SilverStripe to WordPress.
              </p>
              <footer class="card-footer">
                <div class="card-tags">
                  <span class="tag">WordPress</span>
                  <span class="tag">Migration</span>
                  <span class="tag">Custom Search</span>
                </div>
                <a href="https://guildofpsychotherapists.org.uk" target="_blank" rel="noopener" class="card-cta" onclick="event.stopPropagation();">Visit ↗</a>
              </footer>
            </article>

            <!-- Client: Claire Lynch Consulting -->
            <article class="project-card reveal client-project"
                     data-project="claire"
                     role="button" tabindex="0"
                     aria-label="Open Claire Lynch Consulting project detail">
              <div class="card-tape card-tape--blue"></div>
              <div class="card-fold"></div>
              <header class="card-header">
                <span class="card-label">Client Site</span>
                <div class="card-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              </header>
              <h3 class="card-title">Claire Lynch Consulting</h3>
              <p class="card-desc">
                Business and human rights advisory site. Responsive landing pages with service breakdowns and contact flows.
              </p>
              <footer class="card-footer">
                <div class="card-tags">
                  <span class="tag">WordPress</span>
                  <span class="tag">Responsive</span>
                </div>
                <a href="https://clairelynchconsulting.com" target="_blank" rel="noopener" class="card-cta" onclick="event.stopPropagation();">Visit ↗</a>
              </footer>
            </article>

            <!-- Client: Rehabit UK -->
            <article class="project-card reveal client-project"
                     data-project="rehabit"
                     role="button" tabindex="0"
                     aria-label="Open Rehabit UK project detail">
              <div class="card-tape card-tape--purple"></div>
              <div class="card-fold"></div>
              <header class="card-header">
                <span class="card-label">Client Site</span>
                <div class="card-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              </header>
              <h3 class="card-title">Rehabit UK</h3>
              <p class="card-desc">
                Addiction counseling charity site. Streamlined referral form UX and volunteer application system.
              </p>
              <footer class="card-footer">
                <div class="card-tags">
                  <span class="tag">WordPress</span>
                  <span class="tag">Forms</span>
                  <span class="tag">UX</span>
                </div>
                <a href="https://rehabit.uk" target="_blank" rel="noopener" class="card-cta" onclick="event.stopPropagation();">Visit ↗</a>
              </footer>
            </article>

            <!-- ── PERSONAL PROJECTS ───────────────────────────────── -->
            <h3 class="project-group-heading reveal">Personal Projects</h3>

            <!-- Personal: Repwise -->
            <article class="project-card reveal"
                     data-project="repwise"
                     role="button" tabindex="0"
                     aria-label="Open Repwise project detail">
              <div class="card-tape card-tape--red"></div>
              <div class="card-fold"></div>
              <header class="card-header">
                <span class="card-label">Personal Project</span>
                <div class="card-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              </header>
              <h3 class="card-title">Repwise</h3>
              <p class="card-desc">
                React Native app for tracking strength training. Natural language input for quick workout logging. Works offline.
              </p>
              <footer class="card-footer">
                <div class="card-tags">
                  <span class="tag">React Native</span>
                  <span class="tag">TypeScript</span>
                  <span class="tag">SQLite</span>
                </div>
                <span class="card-cta" aria-hidden="true">Details ↗</span>
              </footer>
            </article>

            <!-- Personal: Life of Death -->
            <article class="project-card reveal"
                     data-project="lifeofdeath"
                     role="button" tabindex="0"
                     aria-label="Open The Life of Death project detail">
              <div class="card-tape card-tape--blue"></div>
              <div class="card-fold"></div>
              <header class="card-header">
                <span class="card-label">Experiment</span>
                <div class="card-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              </header>
              <h3 class="card-title">Life of Death</h3>
              <p class="card-desc">
                Interactive web tribute for an animated short. No frameworks — just semantic HTML, CSS animations, and careful pacing.
              </p>
              <footer class="card-footer">
                <div class="card-tags">
                  <span class="tag">HTML</span>
                  <span class="tag">CSS</span>
                  <span class="tag">JavaScript</span>
                </div>
                <span class="card-cta" aria-hidden="true">Details ↗</span>
              </footer>
            </article>

          </div><!-- /project-list -->

          <!--
            project-detail: lives in the page layout.
            GSAP expands this from width:0 while compressing project-list.
            No fixed position. No overlay. The section itself reshapes.
          -->
          <div class="project-detail" id="project-detail" aria-hidden="true">
            <div class="project-detail-inner">
              <div class="card-fold"></div>

              <button class="project-detail-back" id="project-detail-back"
                      aria-label="Close project detail">
                ← Back to projects
              </button>

              <p class="detail-eyebrow" id="detail-eyebrow"></p>
              <h2 class="detail-title" id="detail-title"></h2>
              <p class="detail-desc" id="detail-desc"></p>

              <div class="detail-metrics" id="detail-metrics"></div>

              <h3 class="detail-section-title">Context</h3>
              <p class="detail-body" id="detail-problem"></p>

              <h3 class="detail-section-title">What I did</h3>
              <p class="detail-body" id="detail-solution"></p>

              <h3 class="detail-section-title">Result</h3>
              <p class="detail-body" id="detail-outcome"></p>

              <footer class="detail-footer">
                <div class="detail-tags" id="detail-tags"></div>
                <a class="btn btn-primary" id="detail-link" href="#"
                   target="_blank" rel="noopener">View project ↗</a>
              </footer>
            </div>
          </div><!-- /project-detail -->

        </div><!-- /project-layout -->
      </div>
    </section>

    <!-- ── EXPERIENCE ─────────────────────────────────────────── -->
    <section class="section process-section" id="process" aria-labelledby="process-heading">
      <div class="container">
        <header class="section-header reveal">
          <p class="section-eyebrow">Experience</p>
          <h2 class="section-title" id="process-heading">
            My <span class="title-highlight">Journey</span>.
          </h2>
        </header>

        <ol class="process-list" role="list">
          <li class="process-step reveal">
            <div class="step-number paper-pin" aria-hidden="true">01</div>
            <div class="step-body">
              <h3 class="step-title">Freelance Web Developer (3 Years)</h3>
              <p class="step-desc">
                Specialized in delivering professional web solutions for charitable organizations. Notably collaborated in a team to migrate a psychotherapist guild from SilverStripe to WordPress (50-100 pages), building reusable Gutenberg components and a custom "Find a Therapist" feature that connects patients with qualified practitioners.
              </p>
            </div>
          </li>
          <li class="process-step reveal">
            <div class="step-number paper-pin" aria-hidden="true">02</div>
            <div class="step-body">
              <h3 class="step-title">Founders &amp; Coders</h3>
              <p class="step-desc">
                Graduate of the highly selective full-stack apprenticeship program, where I solidified my foundation in software engineering and team-driven development.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ── ABOUT ────────────────────────────────────────────────── -->
    <section class="section about-section" id="about" aria-labelledby="about-heading">
      <div class="container">
        <div class="about-layout">

          <div class="about-left reveal">
            <header class="section-header">
              <p class="section-eyebrow">About me</p>
              <h2 class="section-title" id="about-heading">
                Structuring <span class="title-highlight">clean</span> applications.
              </h2>
            </header>
            <div class="about-bio">
              <p>
                In an era where AI tools can quickly generate boilerplate code, my focus is on what automation can't do on its own: structuring clean applications, defining clear data flows, and effectively orchestrating AI to accelerate development without sacrificing code quality.
              </p>
              <p>
                A graduate of the Founders &amp; Coders full-stack apprenticeship, I recently transitioned from 3 years of freelance development where I delivered professional, high-quality web solutions for charitable organizations.
              </p>
              <blockquote class="pi-philosophy">
                <strong>Pi Philosophy:</strong> Leverage AI coding agents for rapid prototyping and boilerplate generation while maintaining human oversight for architecture decisions, code review, and quality assurance.
              </blockquote>
              <ul class="capabilities-list">
                <li><strong>Programming Quality</strong> — Maintainable code backed by rigorous automated testing.</li>
                <li><strong>Frontend Craftsmanship</strong> — Deep understanding of CSS, plain JS, and the DOM.</li>
                <li><strong>System Integration</strong> — Connecting front-end and back-end, migrating legacy databases, integrating AI APIs.</li>
                <li><strong>DevOps &amp; Infrastructure</strong> — NixOS-based VPS management, Docker containerization, declarative system configuration.</li>
              </ul>
            </div>
            <div class="about-skills" aria-label="Skills">
              <span class="skill-chip">JavaScript</span>
              <span class="skill-chip">TypeScript</span>
              <span class="skill-chip">React</span>
              <span class="skill-chip">Astro</span>
              <span class="skill-chip">SQLite</span>
              <span class="skill-chip">HTML/CSS</span>
              <span class="skill-chip">NixOS</span>
              <span class="skill-chip">Docker</span>
              <span class="skill-chip">AI Workflows</span>
            </div>
          </div>

          <div class="about-right reveal">
            <div class="about-photo-card">
              <div class="card-fold"></div>
              <div class="about-photo" aria-label="Karol">K</div>
              <div class="about-photo-caption">
                <span>Karol</span>
                <span class="caption-role">Full-Stack Developer</span>
              </div>
            </div>

            <div class="stat-grid">
              <div class="stat-card reveal">
                <span class="stat-num">3</span>
                <span class="stat-label">years freelance</span>
              </div>
              <div class="stat-card reveal">
                <span class="stat-num">120+</span>
                <span class="stat-label">tests written</span>
              </div>
              <div class="stat-card reveal">
                <span class="stat-num">∞</span>
                <span class="stat-label">AI prompts crafted</span>
              </div>
              <div class="stat-card reveal">
                <span class="stat-num">100</span>
                <span class="stat-label">Lighthouse scores</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ── CONTACT ──────────────────────────────────────────────── -->
    <section class="section contact-section" id="contact" aria-labelledby="contact-heading">
      <div class="container">
        <div class="contact-layout">

          <div class="contact-left reveal">
            <p class="section-eyebrow">Get in touch</p>
            <h2 class="contact-title" id="contact-heading">
              Let's build<br>something great.
            </h2>
            <p class="contact-sub">
              Whether you have a project in mind, want to chat about an opportunity, or just want to say hi — my inbox is open.
            </p>
            <a href="mailto:karol@ko-karol.com" class="btn btn-primary btn-large">
              <span>karol@ko-karol.com</span>
              <span aria-hidden="true">→</span>
            </a>
            <div class="contact-links" role="list" aria-label="Social links">
              <a href="https://github.com/ko-karol" class="contact-social"
                 target="_blank" rel="noopener" role="listitem">GitHub</a>
              <span class="contact-sep" aria-hidden="true">·</span>
              <a href="https://www.linkedin.com/in/ko-karol/" class="contact-social"
                 target="_blank" rel="noopener" role="listitem">LinkedIn</a>
            </div>
          </div>

          <div class="contact-right reveal">
            <div class="contact-card">
              <div class="card-fold"></div>
              <div class="card-tape card-tape--red"></div>
              <form class="contact-form" id="contact-form" novalidate>
                <div class="form-group">
                  <label for="form-name">Name</label>
                  <input id="form-name" name="name" type="text" autocomplete="name"
                         placeholder="Your name" required />
                </div>
                <div class="form-group">
                  <label for="form-email">Email</label>
                  <input id="form-email" name="email" type="email" autocomplete="email"
                         placeholder="you@example.com" required />
                </div>
                <div class="form-group">
                  <label for="form-message">Message</label>
                  <textarea id="form-message" name="message" rows="4"
                            placeholder="Tell me about your project…" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Send message</button>
                <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
              </form>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
</Layout>
