---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const reads = (await getCollection('reads')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Signal | Karol"
  description="Articles and essays Karol has found valuable, with short commentary."
>
  <div class="signal">
    <div class="signal-head">
      <h1>Valuable Reads</h1>
      <p>A curated collection of articles, essays, and resources I've found insightful.</p>
    </div>
  <div class="reads">
  {reads.map(({ data }) => (
    <article class="read">
      <p class="meta"><time datetime={data.date.toISOString()}>{data.date.toISOString().slice(0, 10)}</time></p>
      <div class="read-body">
        <h2><a href={data.url}>{data.title}</a></h2>
        <p class="meta">{data.author}</p>
        <blockquote>{data.commentary}</blockquote>
      </div>
      <ul class="tags">
        {data.tags.map((t) => <li>{t}</li>)}
      </ul>
    </article>
  ))}
  </div>
  </div>
</Layout>
