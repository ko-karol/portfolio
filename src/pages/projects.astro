---
import Layout from '../layouts/Layout.astro';
import ProjectList from '../components/ProjectList.astro';
---

<Layout title="Projects | Karol"
  description="Client websites for nonprofits and charities, plus personal projects including a React Native strength-training app."
>
  <h1>Projects</h1>

  <div class="split">
    <section>
      <h2>Client work</h2>
      <ProjectList kind="client" />
    </section>

    <section>
      <h2>Personal projects</h2>
      <ProjectList kind="personal" />
    </section>
  </div>
</Layout>
